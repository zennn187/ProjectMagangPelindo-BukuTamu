# ============================================================
# ENVIRONMENT VARIABLES WAJIB DI VERCEL (bukan di file .env)
# Dashboard: Project → Settings → Environment Variables
# Scope: Production + Preview + Development, lalu Redeploy
# Composer dependency dipasang otomatis oleh runtime vercel-php.
# Build project hanya menjalankan npm install dan npm run build.
# ============================================================
#
# APP_NAME=BukuTamu
# APP_ENV=production
# APP_DEBUG=false            ← WAJIB false di production, kalau true kadang 500 dibungkus blank
# APP_URL=https://projectmagangpelindo-bukutamu.vercel.app
# APP_KEY=base64:xxxx        ← generate via `php artisan key:generate --show`, copy hasilnya
#
# SESSION_DRIVER=cookie      ← filesystem Vercel read-only, driver database/file = 500
# CACHE_STORE=array
# QUEUE_CONNECTION=sync
# LOG_CHANNEL=stderr         ← supaya error terlihat di tab Logs Vercel
# LOG_LEVEL=error
#
# DATABASE (WAJIB — sqlite TIDAK BISA di Vercel, file hilang tiap invocation):
# Opsi gratis: Neon (neon.tech) / Supabase / PlanetScale / Aiven
# DB_CONNECTION=mysql        ← atau pgsql sesuai provider
# DB_HOST=xxxx
# DB_PORT=3306
# DB_DATABASE=xxxx
# DB_USERNAME=xxxx
# DB_PASSWORD=xxxx
# MYSQL_ATTR_SSL_CA=         ← kosongkan kecuali provider mewajibkan SSL CA
#
# Setelah DB diset: jalankan migrate SEKALI dari lokal:
#   DB_CONNECTION=mysql DB_HOST=... php artisan migrate --force
#
# WHATSAPP_ENABLED=false     ← biarkan false kalau belum ada API WA di server
